        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "logkeeper_consensus_media_responsive{job=\"logkeeper\", instance=~\"$instance\"}",
          "legendFormat": "media responsive {{instance}}",
          "refId": "B"
