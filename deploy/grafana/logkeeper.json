          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "logkeeper_consensus_wal_healthy{job=\"logkeeper\", instance=~\"$instance\"}",
          "legendFormat": "wal healthy {{instance}}",
          "refId": "A"
