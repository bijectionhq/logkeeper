[Unit]
Description=Logkeeper stream journal keeper
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
RuntimeDirectory=logkeeper
RuntimeDirectoryMode=0700
ExecStartPre=-/usr/bin/docker rm -f logkeeper
ExecStart=/usr/local/sbin/logkeeper-keeper
ExecStop=-/usr/bin/docker stop --time 60 logkeeper
TimeoutStopSec=75
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
