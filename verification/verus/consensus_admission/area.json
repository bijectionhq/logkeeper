{
  "summary": "Verify the shipped consensus admission, metering, classification, rotation, batch and restart and operator recovery decisions against the PeerBudget, Headroom and RestartRead laws.",
  "flags": [
    "--no-external-by-default",
    "--verify-module",
    "production",
    "--verify-module",
    "laws"
  ],
  "min_verified_functions": 62,
  "controls": {
    "hide-application-entry": {
      "defect": "classify a payload batch as metadata only",
      "mutate": [
        {
          "file": "src/stream/consensus/decisions.rs",
          "find": "            return true;",
          "replace": "            return false;"
        }
      ],
      "expect": [
        {
          "file": "src/stream/consensus/decisions.rs",
          "function": "carries_application",
          "category": "postcondition not satisfied"
        }
      ],
      "min_verified_functions": 61
    },
    "replicate-on-control": {
      "defect": "send application entries on the control lane",
