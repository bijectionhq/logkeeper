{
  "summary": "Canonical bounded and strictly ordered 32-byte names in the shipped command, compact-image and service record codecs.",
  "flags": [
    "--no-external-by-default",
    "--verify-module",
    "production",
    "--verify-module",
    "laws",
    "--verify-module",
    "budget"
  ],
  "min_verified_functions": 14,
  "controls": {
    "reverse-byte-order": {
      "defect": "Comparison reverses ordering at the first unequal byte.",
      "mutate": [
        {
          "file": "src/ordered/object_names.rs",
          "find": "return left[i] < right[i];",
          "replace": "return right[i] < left[i];"
        }
      ],
      "expect": [
        {
          "file": "src/ordered/object_names.rs",
          "function": "name_before",
          "category": "postcondition not satisfied"
        }
      ],
      "min_verified_functions": 13
    },
    "exclude-exact-bound": {
      "defect": "The largest canonical name list is rejected.",
      "mutate": [
        {
          "file": "src/ordered/object_names.rs",
          "find": "if names.len() > MAX_OBJECT_REFERENCES {",
          "replace": "if names.len() >= MAX_OBJECT_REFERENCES {"
        }
      ],
      "expect": [
        {
          "file": "src/ordered/object_names.rs",
          "function": "valid_object_names",
          "category": "postcondition not satisfied"
        }
      ],
      "min_verified_functions": 13
    },
    "allow-zero-name": {
      "defect": "The all-zero object name is admissible at the first position.",
      "mutate": [
        {
          "file": "src/ordered/object_names.rs",
          "find": "    if !name_before(&zero, &names[0]) {\n        return false;\n    }",
          "replace": "    if !name_before(&zero, &names[0]) {\n        return true;\n    }"
        }
      ],
      "expect": [
        {
          "file": "src/ordered/object_names.rs",
          "function": "valid_object_names",
          "category": "postcondition not satisfied"
        }
      ],
      "min_verified_functions": 13
    }
  }
}
