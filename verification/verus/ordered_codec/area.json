{
  "summary": "Exact version, journal-time bytes, optional flag spellings and bounded body lengths in the shipped ordered codecs.",
  "flags": [
    "--no-external-by-default",
    "--verify-module",
    "production",
    "--verify-module",
    "laws"
  ],
  "min_verified_functions": 26,
  "controls": {
    "accept-future-command-version": {
      "defect": "A later command version is treated as v9.",
      "mutate": [
        {
          "file": "src/ordered/codec/frame.rs",
          "find": "    version == COMMAND_VERSION\n",
          "replace": "    version >= COMMAND_VERSION\n"
        }
      ],
      "expect": [
        {
          "file": "src/ordered/codec/frame.rs",
          "function": "has_command_version",
          "category": "postcondition not satisfied"
        }
      ],
      "min_verified_functions": 14
    },
    "reverse-journal-time": {
      "defect": "Decode reads the low byte as the high byte.",
      "mutate": [
        {
          "file": "src/ordered/codec/frame.rs",
          "find": "        frame[1], frame[2], frame[3], frame[4], frame[5], frame[6], frame[7], frame[8],",
          "replace": "        frame[8], frame[2], frame[3], frame[4], frame[5], frame[6], frame[7], frame[1],"
        }
      ],
      "expect": [
        {
          "file": "src/ordered/codec/frame.rs",
          "function": "read_decision_time",
          "category": "assertion failed"
        }
      ],
      "min_verified_functions": 14
    },
    "swap-encoded-flag": {
      "defect": "The encoder uses the opposite flag for presence.",
      "mutate": [
        {
          "file": "src/ordered/codec/frame.rs",
          "find": "    if value { 1 } else { 0 }\n}\n\n#[cfg_attr",
          "replace": "    if value { 0 } else { 1 }\n}\n\n#[cfg_attr"
        }
      ],
      "expect": [
        {
          "file": "src/ordered/codec/frame.rs",
          "function": "encode_flag",
          "category": "postcondition not satisfied"
        }
      ],
      "min_verified_functions": 14
    },
    "allow-alternate-true-marker": {
      "defect": "Even with a weakened decoder contract, byte 2 cannot alias true.",
      "mutate": [
        {
          "file": "src/ordered/codec/frame.rs",
          "find": "_ => None,",
          "replace": "_ => Some(true),"
        },
        {
          "file": "src/ordered/codec/frame.rs",
          "find": "else if tag == 1 { Some(true) } else { None }",
          "replace": "else { Some(true) }"
        }
      ],
      "expect": [
        {
          "file": "verification/verus/ordered_codec/laws.rs",
          "function": "noncanonical_flag_is_rejected",
          "category": "assertion failed"
        }
      ],
      "min_verified_functions": 14
    },
    "ignore-body-maximum": {
      "defect": "Even with a weakened length contract, a body above the capacity must be refused.",
      "mutate": [
        {
          "file": "src/ordered/codec/frame.rs",
          "find": "if declared < minimum as u64 || declared > maximum as u64 {",
          "replace": "if declared < minimum as u64 || declared > usize::MAX as u64 {"
        },
        {
          "file": "src/ordered/codec/frame.rs",
          "find": "length as int == declared && bodyLengthBounded(declared as int, minimum as int, maximum as int),",
          "replace": "length as int == declared && minimum as int <= declared <= usize::MAX,"
        },
        {
          "file": "src/ordered/codec/frame.rs",
          "find": "None => !bodyLengthBounded(declared as int, minimum as int, maximum as int),",
          "replace": "None => declared < minimum as int || declared > usize::MAX,"
        }
      ],
      "expect": [
        {
          "file": "verification/verus/ordered_codec/laws.rs",
          "function": "body_over_limit_is_rejected",
          "category": "assertion failed"
        },
        {
          "file": "src/ordered/codec/frame.rs",
          "function": "object_name_count",
          "category": "postcondition not satisfied"
        }
      ],
      "min_verified_functions": 13
    },
    "accept-short-journal-time": {
      "defect": "Even with a weakened decoder contract, a truncated header cannot yield a journal time.",
      "mutate": [
        {
          "file": "src/ordered/codec/frame.rs",
          "find": "        Some(time) => decisionHeaderMatches(frame@, time@),",
          "replace": "        Some(time) => frame@.len() < 9 || decisionHeaderMatches(frame@, time@),"
        },
        {
          "file": "src/ordered/codec/frame.rs",
          "find": "    if frame.len() < 9 || !has_command_version(frame[0]) {",
          "replace": "    if frame.len() < 9 { return Some([0; 8]); }\n    if !has_command_version(frame[0]) {"
        }
      ],
      "expect": [
        {
          "file": "verification/verus/ordered_codec/laws.rs",
          "function": "short_decision_header_is_rejected",
          "category": "assertion failed"
        },
        {
          "file": "src/ordered/codec/frame.rs",
          "function": "decision_request_parts",
          "category": "postcondition not satisfied"
        },
        {
          "file": "src/ordered/codec/frame.rs",
          "function": "decision_request_parts",
          "category": "precondition not satisfied"
        },
        {
          "file": "src/ordered/codec/frame.rs",
          "function": "decision_request_parts",
          "category": "precondition not satisfied"
        }
      ],
      "min_verified_functions": 14
    },
    "accept-torn-object-name": {
      "defect": "A count may exceed the number of complete 32-byte names left in the input.",
      "mutate": [
        {
          "file": "src/ordered/codec/frame.rs",
          "find": "maximum.min(remaining / 32)",
          "replace": "maximum.min(remaining)"
        }
      ],
      "expect": [
        {
          "file": "src/ordered/codec/frame.rs",
          "function": "object_name_count",
          "category": "postcondition not satisfied"
        }
      ],
      "min_verified_functions": 14
    },
    "pass-time-byte-to-command": {
      "defect": "Decision decoding passes the final journal-time byte to the command decoder.",
      "mutate": [
        {
          "file": "src/ordered/codec/frame.rs",
          "find": "let (_, fields) = frame.split_at(9);",
          "replace": "let (_, fields) = frame.split_at(8);"
        }
      ],
      "expect": [
        {
          "file": "src/ordered/codec/frame.rs",
          "function": "decision_request_parts",
          "category": "postcondition not satisfied"
        }
      ],
      "min_verified_functions": 23
    },
    "accept-zero-withdrawal-version": {
      "defect": "A typed withdrawal with an empty provider version enters the command codec domain.",
      "mutate": [
        {
          "file": "src/ordered/codec/frame.rs",
          "find": "!matches_fingerprint(name, &zero) && !matches_fingerprint(version, &zero)",
          "replace": "!matches_fingerprint(name, &zero)"
        }
      ],
      "expect": [
        {
          "file": "src/ordered/codec/frame.rs",
          "function": "withdrawal_identity_admissible",
          "category": "postcondition not satisfied"
        }
      ],
      "min_verified_functions": 23
    },
    "accept-over-limit-worker-page": {
      "defect": "The reply decoder accepts an oversized withdrawn-worker page.",
      "mutate": [
        {
          "file": "src/ordered/codec/frame.rs",
          "find": "MAX_WITHDRAWN_WORKERS: usize = 64;",
          "replace": "MAX_WITHDRAWN_WORKERS: usize = 65;"
        },
        {
          "file": "src/ordered/codec/frame.rs",
          "find": "withdrawnWorkerCountBounded(count: int) -> bool { count <= 64 }",
          "replace": "withdrawnWorkerCountBounded(count: int) -> bool { count <= 65 }"
        }
      ],
      "expect": [
        {
          "file": "verification/verus/ordered_codec/laws.rs",
          "function": "oversized_withdrawn_worker_count_is_rejected",
          "category": "assertion failed"
        }
      ],
      "min_verified_functions": 23
    },
    "accept-truncated-fixed-field": {
      "defect": "A missing fixed-width field produces zero bytes rather than failing.",
      "mutate": [
        {
          "file": "src/ordered/codec/frame.rs",
          "find": "    let (prefix, _) = frame.split_at_checked(N)?;",
          "replace": "    let Some((prefix, _)) = frame.split_at_checked(N) else { return Some([0; N]); };"
        }
      ],
      "expect": [
        {
          "file": "src/ordered/codec/frame.rs",
          "function": "read_fixed_field",
          "category": "postcondition not satisfied"
        }
      ],
      "min_verified_functions": 25
    }
  }
}
