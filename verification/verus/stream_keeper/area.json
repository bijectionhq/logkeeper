{
  "summary": "Verify keeper admission, head bounds, and reply projections over the primitive shipped rules.",
  "flags": [
    "--no-external-by-default",
    "--verify-module",
    "production",
    "--verify-module",
    "laws"
  ],
  "min_verified_functions": 24,
  "controls": {
    "reuse-deleted-stream": {
      "defect": "Create passes a tombstone.",
      "mutate": [
        {
          "file": "src/stream/keeper/rules.rs",
          "find": "    !deleted\n",
          "replace": "    let _ = deleted;\n    true\n"
        },
        {
          "file": "src/stream/keeper/rules.rs",
          "find": "ensures out == !deleted",
          "replace": "ensures out"
        }
      ],
      "expect": [
        {
          "file": "verification/verus/stream_keeper/laws.rs",
          "function": "create_cannot_reuse_a_stream_id",
          "category": "assertion failed"
        }
      ],
      "min_verified_functions": 23
    },
    "seal-equal-other-identity": {
      "defect": "An equal epoch may switch identities.",
      "mutate": [
        {
          "file": "src/stream/keeper/rules.rs",
          "find": "    !has_promise || current < epoch || (current == epoch && same_identity)\n",
          "replace": "    let _ = same_identity;\n    !has_promise || current <= epoch\n"
        },
        {
          "file": "src/stream/keeper/rules.rs",
          "find": "out == (!has_promise || current < epoch || (current == epoch && same_identity))",
          "replace": "out == (!has_promise || current <= epoch)"
        }
      ],
      "expect": [
        {
          "file": "verification/verus/stream_keeper/laws.rs",
          "function": "seal_requires_a_higher_epoch_or_same_identity",
          "category": "assertion failed"
        }
      ],
      "min_verified_functions": 23
    },
    "sync-overwrite-head": {
      "defect": "Sync can replace an unequal committed record.",
      "mutate": [
        {
          "file": "src/stream/keeper/rules.rs",
          "find": "    from > head || identical\n",
          "replace": "    let _ = (from, head, identical);\n    true\n"
        },
        {
          "file": "src/stream/keeper/rules.rs",
          "find": "ensures out == (from > head || identical)",
          "replace": "ensures out"
        }
      ],
      "expect": [
        {
          "file": "verification/verus/stream_keeper/laws.rs",
          "function": "sync_cannot_replace_headted_records",
          "category": "assertion failed"
        }
      ],
      "min_verified_functions": 23
    },
    "sync-regress-head": {
      "defect": "Sync can move the local head backwards.",
      "mutate": [
        {
          "file": "src/stream/keeper/rules.rs",
          "find": "    current <= next && next <= tail && floor > 0 && floor - 1 <= next\n",
          "replace": "    let _ = current;\n    next <= tail && floor > 0 && floor - 1 <= next\n"
        },
        {
          "file": "src/stream/keeper/rules.rs",
          "find": "out == (current <= next && next <= tail && 0 < floor && floor as int <= next as int + 1)",
          "replace": "out == (next <= tail && 0 < floor && floor as int <= next as int + 1)"
        }
      ],
      "expect": [
        {
          "file": "verification/verus/stream_keeper/laws.rs",
          "function": "sync_head_is_monotone_and_bounded",
          "category": "assertion failed"
        }
      ],
      "min_verified_functions": 23
    },
    "append-before-sync": {
      "defect": "A promise alone can authorize an append.",
      "mutate": [
        {
          "file": "src/stream/keeper/rules.rs",
          "find": "    promised && synced\n",
          "replace": "    let _ = synced;\n    promised\n"
        },
        {
          "file": "src/stream/keeper/rules.rs",
          "find": "out == (promised && synced)",
          "replace": "out == promised"
        }
      ],
      "expect": [
        {
          "file": "verification/verus/stream_keeper/laws.rs",
          "function": "append_requires_both_current_promise_and_sync",
          "category": "assertion failed"
        }
      ],
      "min_verified_functions": 23
    },
    "append-conflicting-retry": {
      "defect": "A different payload can count as a retry.",
      "mutate": [
        {
          "file": "src/stream/keeper/rules.rs",
          "find": "    nonempty && last <= tail && identical\n",
          "replace": "    let _ = identical;\n    nonempty && last <= tail\n"
        },
        {
          "file": "src/stream/keeper/rules.rs",
          "find": "out == (nonempty && last <= tail && identical)",
          "replace": "out == (nonempty && last <= tail)"
        }
      ],
      "expect": [
        {
          "file": "verification/verus/stream_keeper/laws.rs",
          "function": "append_retry_must_match_the_whole_existing_range",
          "category": "assertion failed"
        }
      ],
      "min_verified_functions": 23
    },
    "trim-uncommitted": {
      "defect": "Trim can discard uncommitted records.",
      "mutate": [
        {
          "file": "src/stream/keeper/rules.rs",
          "find": "    through <= head\n",
          "replace": "    let _ = (through, head);\n    true\n"
        },
        {
          "file": "src/stream/keeper/rules.rs",
          "find": "ensures out == (through <= head)",
          "replace": "ensures out"
        }
      ],
      "expect": [
        {
          "file": "verification/verus/stream_keeper/laws.rs",
          "function": "trim_cannot_cross_the_head",
          "category": "assertion failed"
        }
      ],
      "min_verified_functions": 23
    },
    "check-invent-tail": {
      "defect": "Check returns a request field as the durable tail.",
      "mutate": [
        {
          "file": "src/stream/keeper/rules.rs",
          "find": "    current\n",
          "replace": "    let _ = current;\n    _request_epoch\n"
        },
        {
          "file": "src/stream/keeper/rules.rs",
          "find": "out == current))]",
          "replace": "out == _request_epoch))]"
        }
      ],
      "expect": [
        {
          "file": "verification/verus/stream_keeper/laws.rs",
          "function": "check_reports_the_existing_tail",
          "category": "assertion failed"
        }
      ],
      "min_verified_functions": 23
    },
    "read-accepted-tail": {
      "defect": "Read exposes the accepted tail.",
      "mutate": [
        {
          "file": "src/stream/keeper/rules.rs",
          "find": "    head\n",
          "replace": "    let _ = head;\n    _accepted\n"
        },
        {
          "file": "src/stream/keeper/rules.rs",
          "find": "out == head))]",
          "replace": "out == _accepted))]"
        }
      ],
      "expect": [
        {
          "file": "verification/verus/stream_keeper/laws.rs",
          "function": "read_cannot_expose_the_accepted_tail",
          "category": "assertion failed"
        }
      ],
      "min_verified_functions": 23
    },
    "read-below-floor": {
      "defect": "Read accepts a position below the retained floor.",
      "mutate": [
        {
          "file": "src/stream/keeper/rules.rs",
          "find": "    floor <= from\n",
          "replace": "    let _ = (floor, from);\n    true\n"
        },
        {
          "file": "src/stream/keeper/rules.rs",
          "find": "ensures out == (floor <= from)",
          "replace": "ensures out"
        }
      ],
      "expect": [
        {
          "file": "verification/verus/stream_keeper/laws.rs",
          "function": "read_cannot_cross_the_floor",
          "category": "assertion failed"
        }
      ],
      "min_verified_functions": 23
    },
    "delete-clears-tombstone": {
      "defect": "A later operation can clear the tombstone.",
      "mutate": [
        {
          "file": "src/stream/keeper/rules.rs",
          "find": "    deleted || deleting\n",
          "replace": "    let _ = deleted;\n    deleting\n"
        },
        {
          "file": "src/stream/keeper/rules.rs",
          "find": "out == (deleted || deleting)",
          "replace": "out == deleting"
        }
      ],
      "expect": [
        {
          "file": "verification/verus/stream_keeper/laws.rs",
          "function": "delete_is_terminal",
          "category": "assertion failed"
        }
      ],
      "min_verified_functions": 23
    },
    "replace-without-sync": {
      "defect": "A keeper can enter a new ensemble before completing the chosen history.",
      "mutate": [
        {
          "file": "src/stream/keeper/rules.rs",
          "find": "    current && synced && member && changed == 1\n",
          "replace": "    let _ = synced;\n    current && member && changed == 1\n"
        },
        {
          "file": "src/stream/keeper/rules.rs",
          "find": "out == (current && synced && member && changed == 1)",
          "replace": "out == (current && member && changed == 1)"
        }
      ],
      "expect": [
        {
          "file": "verification/verus/stream_keeper/laws.rs",
          "function": "replace_requires_a_synced_current_ensemble_with_one_new_member",
          "category": "assertion failed"
        }
      ],
      "min_verified_functions": 23
    }
  }
}
