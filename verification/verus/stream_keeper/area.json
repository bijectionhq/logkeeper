{
  "summary": "Verify keeper admission, head bounds, and reply projections over the primitive shipped rules.",
  "flags": [
    "--no-external-by-default",
    "--verify-module",
    "production",
    "--verify-module",
    "laws"
  ],
  "min_verified_functions": 30,
  "controls": {
    "reuse-deleted-stream": {
      "defect": "Create passes a tombstone.",
      "mutate": [
        {
          "file": "src/stream/keeper/rules.rs",
          "find": "    !deleted\n",
          "replace": "    let _ = deleted;\n    true\n"
        },
        {
          "file": "src/stream/keeper/rules.rs",
          "find": "ensures out == !deleted",
          "replace": "ensures out"
        }
      ],
      "expect": [
        {
          "file": "verification/verus/stream_keeper/laws.rs",
          "function": "create_cannot_reuse_a_stream_id",
          "category": "assertion failed"
        }
      ],
      "min_verified_functions": 26
    },
    "seal-equal-other-identity": {
      "defect": "An equal epoch may switch identities.",
      "mutate": [
        {
          "file": "src/stream/keeper/rules.rs",
          "find": "    !has_promise || current < epoch || (current == epoch && same_identity)\n",
          "replace": "    let _ = same_identity;\n    !has_promise || current <= epoch\n"
        },
        {
          "file": "src/stream/keeper/rules.rs",
          "find": "out == (!has_promise || current < epoch || (current == epoch && same_identity))",
          "replace": "out == (!has_promise || current <= epoch)"
        }
      ],
      "expect": [
        {
          "file": "verification/verus/stream_keeper/laws.rs",
          "function": "seal_requires_a_higher_epoch_or_same_identity",
          "category": "assertion failed"
        }
      ],
      "min_verified_functions": 26
    },
    "sync-overwrite-head": {
      "defect": "Sync can replace an unequal committed record.",
      "mutate": [
        {
          "file": "src/stream/keeper/rules.rs",
          "find": "    from > head || identical\n",
          "replace": "    let _ = (from, head, identical);\n    true\n"
        },
        {
          "file": "src/stream/keeper/rules.rs",
          "find": "ensures out == (from > head || identical)",
          "replace": "ensures out"
        }
      ],
      "expect": [
        {
          "file": "verification/verus/stream_keeper/laws.rs",
          "function": "sync_cannot_replace_headted_records",
          "category": "assertion failed"
        }
      ],
      "min_verified_functions": 26
    },
    "sync-regress-head": {
      "defect": "Sync can move the local head backwards.",
      "mutate": [
        {
          "file": "src/stream/keeper/rules.rs",
          "find": "    current <= next && next <= tail && floor > 0 && floor - 1 <= next\n",
          "replace": "    let _ = current;\n    next <= tail && floor > 0 && floor - 1 <= next\n"
        },
        {
          "file": "src/stream/keeper/rules.rs",
          "find": "out == (current <= next && next <= tail && 0 < floor && floor as int <= next as int + 1)",
          "replace": "out == (next <= tail && 0 < floor && floor as int <= next as int + 1)"
        }
      ],
      "expect": [
        {
          "file": "verification/verus/stream_keeper/laws.rs",
          "function": "sync_head_is_monotone_and_bounded",
          "category": "assertion failed"
        }
      ],
      "min_verified_functions": 26
    },
